{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000001",
  "packageName": "de.vfb.jobboard",
  "developer": {
    "name": "VfB Stuttgart Design",
    "websiteUrl": "https://vfb.de",
    "privacyUrl": "https://vfb.de/privacy",
    "termsOfUseUrl": "https://vfb.de/terms"
  },
  "name": { "short": "Jobboard", "full": "VfB Design Jobboard" },
